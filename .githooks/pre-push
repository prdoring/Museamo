#!/bin/sh
# Installed locally with npm run release:setup; no global Git settings are changed.
if [ "$1" = "origin" ] && [ "$MUSEAMO_RELEASE_PUSH" != "1" ]; then
  echo "Museamo origin pushes require an explicit verified release publication."
  echo "Build each platform, run release:verify, then release:assemble and release:publish."
  echo "Build and assembly commands never push. See docs/releases.md."
  exit 1
fi
