#!/bin/sh
# Installed locally with npm run release:setup; no global Git settings are changed.
if [ "$1" = "origin" ] && [ "$MUSEAMO_RELEASE_PUSH" != "1" ]; then
  echo "Museamo pushes include locally built downloads. Use npm run release."
  echo "See docs/releases.md for signing, versioning, and test prereleases."
  exit 1
fi
