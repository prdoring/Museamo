{
  "name": "museamo",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "ios:assets": "node scripts/generate-ios-assets.mjs",
    "ios:assets:check": "node scripts/generate-ios-assets.mjs --check",
    "test:ios:assets": "node --test scripts/generate-ios-assets.test.mjs",
    "ios:sync": "npm run ios:assets && npm run ios:assets:check && npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:build": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "ios:launch": "node scripts/run-ios-simulator.mjs",
    "ios:run": "npm run ios:build && npm run ios:launch",
    "ios:signing": "node scripts/ios-signing.mjs",
    "test:ios:distribution": "node --test scripts/ios-testflight.test.mjs scripts/ios-signing.test.mjs",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:doctor": "node scripts/desktop-doctor.mjs",
    "android:sync-core": "node scripts/build-sync-android.mjs",
    "test:sync": "cargo test -p museamo-sync-core",
    "test:ios": "swift test --package-path native/ios/MuseamoNative",
    "test:ios:ui": "node scripts/test-ios-ui.mjs",
    "release": "node scripts/release.mjs check",
    "release:build": "node scripts/release.mjs build",
    "release:assemble": "node scripts/release.mjs assemble",
    "release:verify": "node scripts/release.mjs verify",
    "release:publish": "node scripts/release.mjs publish",
    "release:check": "node scripts/release.mjs check",
    "release:setup": "node scripts/release.mjs setup",
    "release:signing": "node scripts/release.mjs signing",
    "release:signing:backup": "node scripts/release.mjs signing-backup",
    "test:release": "node --test scripts/release.test.mjs scripts/release-prepare.test.mjs scripts/android-ci-signing.test.mjs",
    "release:configure-ci": "node scripts/release-configure-ci.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "8.5.2",
    "@tauri-apps/api": "^2.12.1",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-parse": "^11.0.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
